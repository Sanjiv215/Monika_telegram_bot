# ==============================================================================
# WhatsApp AI Assistant Environment Variables
# ==============================================================================

# --- Google Gemini AI API Configuration ---
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...
# Model to use: 'gemini-2.0-flash' or 'gemini-1.5-flash' (defaults to 'gemini-2.0-flash')
GEMINI_MODEL=gemini-2.0-flash

# --- Meta WhatsApp Cloud API Configuration ---
# Meta System User / Temporary Access Token with 'whatsapp_business_messaging' permission
WHATSAPP_TOKEN=EAAG...
# Meta Phone Number ID (from WhatsApp > API Setup in Meta Developer Portal)
WHATSAPP_PHONE_ID=109876543210987
# Custom secret verification string defined by you for the Meta webhook handshake
VERIFY_TOKEN=your_custom_secure_verify_token_here

# --- Security & Access Control ---
# Comma-separated list of allowed phone numbers with country codes (no '+' or spaces)
# Example: 15551234567,919876543210 (Leave empty to allow all incoming senders)
ALLOWED_PHONE_NUMBERS=15551234567,919876543210

# --- Supabase Configuration ---
# Supabase Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co
# Supabase Service Role Secret Key (from Project Settings > API > service_role)
# Note: DO NOT use the public anon key. The service role key is required for backend operations.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
