# ==============================================================================
# Monika AI Assistant Environment Variables
# ==============================================================================

# --- Google Gemini AI API Configuration ---
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...
# Preferred model (automatically discovers and falls back to available models)
GEMINI_MODEL=gemini-3.6-flash

# --- Telegram Bot Security Configuration ---
# Secret token to verify incoming requests originate legitimately from Telegram
# Matches the secret_token parameter set when calling setWebhook
TELEGRAM_SECRET_TOKEN=your_secure_telegram_secret_token_here
# Comma-separated list of allowed Telegram Chat IDs (Leave blank to allow all senders)
ALLOWED_TELEGRAM_USERS=123456789

# --- Meta WhatsApp Cloud API Configuration (Optional) ---
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_ID=109876543210987
VERIFY_TOKEN=your_custom_secure_verify_token_here

# --- Security & Access Control ---
# Comma-separated list of allowed WhatsApp phone numbers (with country code, no '+')
ALLOWED_PHONE_NUMBERS=919876543210

# --- Supabase Configuration ---
SUPABASE_URL=https://your-project-id.supabase.co
# Supabase Service Role Secret Key (from Project Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
